# Environment variables for Octofit Tracker Frontend
# 
# Copy this file to .env.local and update the values
#
# VITE_CODESPACE_NAME: Required for production/Codespace deployments
#   - In GitHub Codespaces, this is set automatically to your codespace name
#   - Used to construct API URLs: https://${VITE_CODESPACE_NAME}-8000.app.github.dev/api
#   - If not set, falls back to http://localhost:8000/api
#
# Example:
# VITE_CODESPACE_NAME=my-codespace-abc123

VITE_CODESPACE_NAME=
